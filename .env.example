# Copy to .env.local and fill in. Every integration is optional at boot:
# without Supabase the app runs in demo mode on a seeded ledger.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # or NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=                       # or SUPABASE_SERVICE_ROLE_KEY — server only

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts Plaid access tokens and OAuth refresh tokens at rest (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=

# ── Plaid ───────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                          # sandbox | production

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=                      # recurring price, $9/month
STRIPE_PRICE_YEARLY=                       # recurring price, $59/year

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="SubShield <alerts@yourdomain.com>"
CANCELLATION_FROM="SubShield Cancellations <cancel@yourdomain.com>"

# ── Inbox scanning (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── SMS renewal alerts (optional) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ── Error monitoring: Sentry (optional) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for readable stack traces (source-map upload):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Product analytics: PostHog (optional) ───────────────────────────────────
# Cookieless mode is used, so enable "Cookieless server hash mode" in the
# PostHog project settings or events will be dropped.
NEXT_PUBLIC_POSTHOG_KEY=
# EU projects: https://eu.i.posthog.com and https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
